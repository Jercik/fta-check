{
  "name": "fta-check",
  "version": "1.0.1",
  "description": "Thin wrapper around FTA (Fast TypeScript Analyzer) that provides actionable error messages for automated code quality checks and AI agent guidance",
  "keywords": [
    "analyzer",
    "code-quality",
    "complexity",
    "cyclomatic-complexity",
    "fta",
    "halstead",
    "maintainability",
    "typescript"
  ],
  "homepage": "https://github.com/Jercik/fta-check#readme",
  "bugs": {
    "url": "https://github.com/Jercik/fta-check/issues"
  },
  "license": "MIT",
  "author": "Łukasz Jerciński",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jercik/fta-check.git"
  },
  "bin": {
    "fta-check": "bin/fta-check"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsgo --build tsconfig.app.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsgo --build tsconfig.app.json --watch",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --check --config .oxfmtrc.json .",
    "fta": "pnpm run build && node ./bin/fta-check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "prepack": "pnpm run clean && pnpm run build",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git config core.hooksPath .githooks; fi",
    "test": "vitest run",
    "typecheck": "tsgo -b --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@j4k/oxlint-config": "^2.11.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "beta",
    "fta-cli": "^3.0.0",
    "knip": "^6.5.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.23.0",
    "semantic-release": "^25.0.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "fta-cli": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
